# Base URL of the running SuperBrain backend (FastAPI), no trailing slash.
# The backend may run on a different machine than this app — do not assume localhost.
SUPERBRAIN_API_URL=http://127.0.0.1:5050

# API access token — same value as backend/token.txt on the machine running
# the backend. Paste the value here; do not commit it.
SUPERBRAIN_API_KEY=

# Password for signing in to this web app. Required: every page and API route
# is behind it. Sessions last 3 weeks; changing this signs everyone out.
WEB_PASSWORD=
