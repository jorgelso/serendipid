# SuperBrain Dashboard environment variables.
# Copy this file to .env and fill in the values below.
# The backend may run on a different machine than this dashboard — do not
# assume localhost, and do not copy backend/token.txt into this folder.

# Base URL of the running SuperBrain backend (FastAPI), no trailing slash.
SUPERBRAIN_API_URL=http://127.0.0.1:5050

# API access token — same value as backend/token.txt on the machine running
# the backend. Paste the value here; do not read the file directly.
SUPERBRAIN_API_KEY=
