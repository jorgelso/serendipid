# Serendipid backend environment (Docker). Copy to .env and fill in what you use.
# Running without Docker? python start.py asks for these interactively and
# stores them in config/.api_keys instead.

# Host port the API is published on
API_PORT=5050
LOG_LEVEL=INFO

# Comma-separated browser origins allowed by CORS. Leave empty for "any origin,
# no credentials". The web app calls the backend server-side and needs no entry.
ALLOWED_ORIGINS=

# AI providers: set at least one. Study guides, importance scoring, embeddings
# (semantic search and chat), eloquence scoring and ANALYSIS_MODE=batch
# require OPENAI_API_KEY; the other providers cover analysis only.
OPENAI_API_KEY=
# OpenAI chat model used by the router (default gpt-4.1)
OPENAI_TEXT_MODEL=
# Optional separate key for the chat feature's answer step
OPENAI_CHAT_API_KEY=
ANTHROPIC_API_KEY=
# Default claude-sonnet-5-5
ANTHROPIC_TEXT_MODEL=
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# immediate (default) or batch (OpenAI Batch API: cheaper, results within 24h)
ANALYSIS_MODE=immediate

# Try this provider first: openai | anthropic | groq | gemini | openrouter | ollama
SERENDIPID_PREFERRED_PROVIDER=

# 1 = also serve posts from sensitive folders (see config/user_config.json)
SERENDIPID_SHOW_SENSITIVE=0

# Optional Instagram login. Use a secondary account, not your main one.
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Transcription through Groq's Whisper API (the Docker image has no local Whisper)
WHISPER_USE_CLOUD=true
