# SuperBrain API Keys
# Copy this file to .api_keys (same directory) and fill in your keys.
# .api_keys is gitignored — never commit your actual keys.
#
# Get API keys at:
#   Groq        → https://console.groq.com/keys (free)
#   Gemini      → https://aistudio.google.com/apikey (free)
#   OpenRouter  → https://openrouter.ai/keys (free models available)
#   OpenAI      → https://platform.openai.com/api-keys (paid)
#
# You don't need all of these — the router falls back automatically.
# If OPENAI_API_KEY is set, GPT-4.1 is tried first (paid, but the model
# quality/setup tradeoff was a deliberate choice for this deployment).
# Local Ollama is always available as the last resort (no key needed).

GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Used ONLY by the RAG chatbot's answer-generation step (core/rag.py via
# ModelRouter.generate_chat_text's "chat" task: Gemini -> OpenAI -> local
# Ollama) — deliberately separate from OPENAI_API_KEY above, which is used
# for post analysis/summaries and for generating embeddings. Optional: if
# unset, the chatbot just skips straight to local Ollama when Gemini fails.
OPENAI_CHAT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Instagram account used for downloading posts (instagrapi / Private API).
# Use a secondary/burner account — not your main personal account.
# Session is cached in .instagram_session.json after first login.
INSTAGRAM_USERNAME=your_instagram_username
INSTAGRAM_PASSWORD=your_instagram_password
